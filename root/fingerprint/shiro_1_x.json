{
  "fingerprintId": "shiro_1_x",
  "name": "shiro",
  "protocol": "http",
  "tags": ["middleware", "java", "auth"],
  "info": {
    "version": "1.x",
    "author": "leo-seed",
    "description": "通过 RememberMe Cookie 触发 Set-Cookie: rememberMe=deleteMe 行为识别 Apache Shiro 1.x 系列。"
  },
  "rule": {
    "requests": [
      {
        "method": "GET",
        "uri": "/",
        "headers": {
          "Cookie": "rememberMe=1"
        },
        "timeout": 5000,
        "charset": "UTF-8",
        "maxBodyBytes": 65536
      }
    ],
    "match": {"any": [
      {"field": "headers", "operator": "contains", "value": "rememberme=deleteme"},
      {"field": "headers", "operator": "contains", "value": "remember-me=delete"}
    ]}
  }
}

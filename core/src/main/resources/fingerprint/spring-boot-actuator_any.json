{
  "fingerprintId": "spring-boot-actuator_any",
  "name": "spring-boot-actuator",
  "protocol": "http",
  "tags": ["middleware", "java", "spring", "management"],
  "info": {
    "version": "any",
    "author": "leo-seed",
    "description": "通过访问 /actuator 路径返回的 _links 对象识别开放的 Spring Boot Actuator 端点。"
  },
  "rule": {
    "requests": [
      {
        "method": "GET",
        "uri": "/actuator",
        "headers": {
          "Accept": "application/json"
        },
        "timeout": 5000,
        "charset": "UTF-8",
        "maxBodyBytes": 65536
      }
    ],
    "match": {"all": [
      {"field": "status", "operator": "in", "value": [200, 401]},
      {"any": [
        {"all": [
          {"field": "body", "operator": "contains", "value": "_links", "ignoreCase": false},
          {"field": "body", "operator": "contains", "value": "actuator"}
        ]},
        {"field": "headers", "operator": "contains", "value": "application/vnd.spring-boot.actuator"}
      ]}
    ]}
  }
}

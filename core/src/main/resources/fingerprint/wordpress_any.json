{
  "fingerprintId": "wordpress_any",
  "name": "wordpress",
  "protocol": "http",
  "tags": ["cms", "php", "blog"],
  "info": {
    "version": "any",
    "author": "leo-seed",
    "description": "通过 /wp-login.php 路径特征或 X-Pingback 响应头识别 WordPress CMS。"
  },
  "rule": {
    "requests": [
      {
        "method": "GET",
        "uri": "/wp-login.php",
        "timeout": 4000,
        "charset": "UTF-8",
        "maxBodyBytes": 65536
      }
    ],
    "match": {"any": [
      {"field": "body", "operator": "contains", "value": "wordpress"},
      {"field": "body", "operator": "contains", "value": "wp-login"},
      {"field": "headers", "operator": "contains", "value": "x-pingback"}
    ]}
  }
}

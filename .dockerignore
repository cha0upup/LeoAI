# The image downloads its JAR; only the entrypoint and shipped VFS seeds are needed.
# Keep local databases, keys, user files and imported resources out of the context.
**
!Dockerfile
!.dockerignore
!docker/
docker/**
!docker/entrypoint.sh
!root/
root/**
!root/disguise/
root/disguise/**
!root/disguise/ZipFileUploadEnvelope_1.0.0.disguise
!root/disguise/jpeg_stego_1.0.0.disguise
!root/disguise/json_serialization_wrapper_001.disguise
!root/disguise/multipart_upload_1.0.0.disguise
!root/disguise/xml_envelope_1.0.0.disguise
!root/fingerprint/
root/fingerprint/**
!root/fingerprint/geoserver_any.json
!root/fingerprint/nacos_any.json
!root/fingerprint/shiro_1_x.json
!root/fingerprint/spring-boot-actuator_any.json
!root/plugin/
root/plugin/**
!root/plugin/EvalScriptPlugin_1.0.0.plugin
!root/plugin/ExecCommandPlugin_1.0.1.plugin
!root/plugin/GetWeblogicPasswordPlugin_1.0.0.plugin
!root/plugin/HeapDumpPlugin_1.0.0.plugin
# Bundled Skills are synchronized from JAR resources during startup.
